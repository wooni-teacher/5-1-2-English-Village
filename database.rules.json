            "$m": {
              ".write": "auth != null && ((auth.uid === $m && (!root.child('english5/banned/'+auth.uid+'/until').exists() || root.child('english5/banned/'+auth.uid+'/until').val() < now) && (data.exists() || root.child('english5/partyInvites/'+$m+'/'+$pid).exists())) || (root.child('english5/parties/'+$pid+'/leader').val() === auth.uid && !newData.exists()))",
              ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 16"
            }
