          ".validate": "newData.hasChildren(['type','from','at']) && newData.child('reason').val().length <= 40",
          "status": {
            ".validate": "newData.val() === 'new' || newData.val() === 'review' || newData.val() === 'done' || newData.val() === 'reject'"
          }
