        "$pid": {
          ".read": "auth != null",
          "$qid": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('english5/parties/'+$pid+'/members/'+auth.uid).exists()",
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        }
      },
