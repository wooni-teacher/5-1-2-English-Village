          ".write": "auth != null && ((!data.exists() && newData.child('owner').val() === auth.uid) || data.child('owner').val() === auth.uid || root.child('english5').child('admins').child(auth.uid).val() === true)",
          ".validate": "!data.exists() || !newData.exists() || newData.child('owner').val() === data.child('owner').val()",
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "desc": {
