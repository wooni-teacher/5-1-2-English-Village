              ".validate": "newData.hasChildren(['t','i','j']) && newData.child('t').isString() && newData.child('i').val() >= 0 && newData.child('i').val() < 10 && newData.child('j').val() >= 0 && newData.child('j').val() < 20"
            }
          }
        }
