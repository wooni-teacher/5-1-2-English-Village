            ".validate": "newData.isNumber() && (newData.val() === (data.exists() ? data.val() : 0) + 1 || (!data.exists() && newData.val() === 0) || root.child('english5').child('admins').child(auth.uid).val() === true || root.child('english5/mapIndex/'+$id+'/owner').val() === auth.uid)"
          },
          "clears": {
            ".validate": "newData.isNumber() && (newData.val() === (data.exists() ? data.val() : 0) + 1 || (!data.exists() && newData.val() === 0) || root.child('english5').child('admins').child(auth.uid).val() === true || root.child('english5/mapIndex/'+$id+'/owner').val() === auth.uid)"
          }
        }
