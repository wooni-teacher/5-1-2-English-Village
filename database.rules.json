        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$f": {
            ".write": "auth != null && (auth.uid === $uid || (auth.uid === $f && (!newData.exists() || root.child('english5/friendRequests/'+$f+'/'+$uid).exists())))"
          }
        }
      },
