        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$pid": {
            ".write": "auth != null && ((root.child('english5/parties/'+$pid+'/leader').val() === auth.uid && newData.child('from').val() === auth.uid && (!root.child('english5/banned/'+auth.uid+'/until').exists() || root.child('english5/banned/'+auth.uid+'/until').val() < now)) || (auth.uid === $uid && !newData.exists()))"
          }
        }
      },
