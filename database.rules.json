            ".write": "auth != null && root.child('english5/parties/'+$pid+'/leader').val() === auth.uid"
          },
          "dungeon": {
            ".write": "auth != null && root.child('english5/parties/'+$pid+'/leader').val() === auth.uid"
          },
          "ping": {
            ".write": "auth != null && root.child('english5/parties/'+$pid+'/members/'+auth.uid).exists()"
          },
          "buff": {
            ".write": "auth != null && root.child('english5/parties/'+$pid+'/members/'+auth.uid).exists()"
          }
        }
      },
