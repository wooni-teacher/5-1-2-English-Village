{
  "rules": {
    "english5": {
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "profiles": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('english5').child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['name','score'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('english5').child('admins').child(auth.uid).val() === true || !data.exists() || newData.val() - data.val() <= 300)"
          },
          "visit": {
            ".validate": "newData.val() === 'public' || newData.val() === 'friends' || newData.val() === 'private'"
          },
          "likes": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      },
      "inventory": {
        ".read": "auth != null && root.child('english5').child('admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('english5').child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && (auth.uid === $uid || root.child('english5').child('admins').child(auth.uid).val() === true)"
        }
      },
      "craftlog": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('english5').child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "quests": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('english5').child('admins').child(auth.uid).val() === true"
      },
      "submissions": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('english5').child('admins').child(auth.uid).val() === true",
        "$qid": {
          "$uid": {
            ".write": "auth != null && (root.child('english5').child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.child('status').val() === 'submitted' && (!data.exists() || data.child('status').val() !== 'approved')))"
          }
        }
      },
      "notice": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('english5').child('admins').child(auth.uid).val() === true"
      },
      "players": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "events": {
        ".read": "auth != null",
        "current": {
          ".write": "auth != null && root.child('english5').child('admins').child(auth.uid).val() === true"
        },
        "next": {
          ".write": "auth != null && root.child('english5').child('admins').child(auth.uid).val() === true"
        },
        "settings": {
          ".write": "auth != null && root.child('english5').child('admins').child(auth.uid).val() === true"
        },
        "contrib": {
          "$eid": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              "p": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() - (data.exists() ? data.val() : 0) <= 60"
              }
            }
          }
        },
        "chests": {
          "$eid": {
            "$i": {
              ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
            }
          }
        }
      },
      "dungeon": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "plots": {
        ".read": "auth != null",
        "$idx": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || root.child('english5').child('admins').child(auth.uid).val() === true)"
        }
      },
      "builds": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || root.child('english5').child('admins').child(auth.uid).val() === true)",
          ".read": "auth != null && (auth.uid === $uid || root.child('english5').child('admins').child(auth.uid).val() === true || root.child('english5/profiles/'+$uid+'/visit').val() === 'public' || (root.child('english5/profiles/'+$uid+'/visit').val() !== 'private' && root.child('english5/friendships/'+$uid+'/'+auth.uid).exists()))"
        }
      },
      "students": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('english5').child('admins').child(auth.uid).val() === true"
      },
      "crafts": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('english5').child('admins').child(auth.uid).val() === true"
      },
