        ".read": "auth != null",
        "current": {
          ".write": "auth != null"
        },
        "settings": {
          ".write": "auth != null && root.child('english5').child('admins').child(auth.uid).val() === true"
        },
        "dmg": {
          "$rid": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.child('d').isNumber() && newData.child('d').val() >= 0 && newData.child('d').val() - (data.exists() ? data.child('d').val() : 0) <= 800"
            }
          }
        }
      },
