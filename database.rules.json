        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('english5').child('admins').child(auth.uid).val() === true)",
          "$day": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.child('at').val() == now"
          }
        }
      },
      "announce": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['text','t','uid']) && newData.child('text').isString() && newData.child('text').val().length <= 80 && newData.child('uid').val() === auth.uid"
      },
      "friendCodes": {
        ".read": "auth != null",
        "$code": {
          ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
          ".validate": "newData.val() === auth.uid"
        }
      },
      "friendRequests": {
        "$target": {
          ".read": "auth != null && auth.uid === $target",
          "$from": {
            ".read": "auth != null && auth.uid === $from",
            ".write": "auth != null && ((auth.uid === $from && (!root.child('english5/banned/'+auth.uid+'/until').exists() || root.child('english5/banned/'+auth.uid+'/until').val() < now) && (!newData.exists() || !data.exists() || data.child('at').val() < now - 3600000)) || (auth.uid === $target && !newData.exists()))",
            ".validate": "newData.hasChildren(['name','at']) && newData.child('at').val() == now && newData.child('name').isString() && newData.child('name').val().length <= 16"
          }
        }
      },
